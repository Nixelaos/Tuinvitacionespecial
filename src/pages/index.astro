---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { HeroDemoPhone } from '../components/HeroDemoPhone';
import { CatalogExplorer } from '../components/CatalogExplorer';
import { FeaturesGrid } from '../components/FeaturesGrid';
import { ProcessSteps } from '../components/ProcessSteps';
import { FaqAccordion } from '../components/FaqAccordion';
import { FloatingWhatsApp } from '../components/FloatingWhatsApp';
import { Footer } from '../components/Footer';
import { BRAND_NAME, WHATSAPP_NUMBER } from '../data/weddingData';
import {
  Sparkles,
  Heart,
  ShieldCheck,
  Clock,
  Send,
  CheckCircle2,
  ArrowRight,
} from 'lucide-react';
import { FaWhatsapp } from 'react-icons/fa6';

const whatsappHeroUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  `¡Hola ${BRAND_NAME}! Quiero recibir información para crear la invitación digital de nuestra boda.`
)}`;
---

<Layout>
  <!-- Navigation Bar -->
  <Navbar client:load />

  <main class="pt-24 sm:pt-28 overflow-hidden">
    <!-- HERO SECTION -->
    <section class="relative py-12 sm:py-20 lg:py-24 bg-linen-pattern border-b border-ivory-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <!-- Left Editorial Copy -->
          <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-champagne/80 border border-gold/35 text-[11px] uppercase tracking-[0.24em] text-gold-dark font-medium">
              <Sparkles className="w-3.5 h-3.5" />
              <span>Colección Nupcial 2026 · 2027</span>
            </div>

            <h1 class="font-serif text-4xl sm:text-6xl lg:text-[66px] text-charcoal leading-[1.06] font-normal">
              Invitaciones digitales de boda con alma de <span class="italic text-gold-dark">alta costura</span>
            </h1>

            <p class="text-base sm:text-lg text-charcoal-muted leading-relaxed max-w-2xl mx-auto lg:mx-0 font-light">
              Sorprende a tus invitados desde el primer instante con un hermoso sobre que se abre al tocarlo,
              su melodía favorita sonando de fondo, mapas para llegar directo con Google Maps o Waze y un
              botón simple para que tus invitados te confirmen su asistencia directamente a tu WhatsApp,
              indicando cuántos lugares usarán y dedicándote un mensaje especial.
            </p>

            <!-- Hero CTAs -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a href="/disenos/invitacion-completa" class="btn-gold w-full sm:w-auto">
                <span>Abrir Invitación Real con Sobre</span>
                <ArrowRight className="w-4 h-4" />
              </a>
              <a href="#catalogo" class="btn-outline-editorial w-full sm:w-auto">
                <span>Explorar Catálogo</span>
              </a>
            </div>

            <!-- Trust Badges -->
            <div class="pt-6 border-t border-ivory-300 grid grid-cols-1 sm:grid-cols-3 gap-4 text-left max-w-xl mx-auto lg:mx-0">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-champagne flex items-center justify-center text-gold-dark shrink-0">
                  <Send className="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-semibold text-charcoal">Envíos Ilimitados</p>
                  <p class="text-[11px] text-charcoal-muted">Por WhatsApp y Correo</p>
                </div>
              </div>

              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-sage-light flex items-center justify-center text-sage-dark shrink-0">
                  <Clock className="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-semibold text-charcoal">Entrega en 48–72 hrs</p>
                  <p class="text-[11px] text-charcoal-muted">Opción exprés 24h</p>
                </div>
              </div>

              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-champagne flex items-center justify-center text-gold-dark shrink-0">
                  <ShieldCheck className="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-semibold text-charcoal">Reserva con el 50%</p>
                  <p class="text-[11px] text-charcoal-muted">Liquida al aprobar</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Interactive Phone Demo -->
          <div class="lg:col-span-5">
            <HeroDemoPhone client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE CATALOG SECTION -->
    <section id="catalogo" class="py-20 sm:py-28">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
          <span class="text-xs uppercase tracking-[0.26em] text-gold-dark font-semibold block">
            Catálogo de Diseños Exclusivos
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl text-charcoal font-normal">
            Elige el escenario digital de vuestra historia
          </h2>
          <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
            Cada diseño es completamente personalizable con vuestras fotografías, paleta de colores
            y música. Haz clic en <strong>«Demo en Vivo»</strong> para interactuar con cada modelo.
          </p>
        </div>

        <CatalogExplorer client:load />
      </div>
    </section>

    <!-- INTERACTIVE FEATURES BENTO SECTION -->
    <section id="funciones" class="py-20 sm:py-28 bg-ivory-200/60 border-y border-ivory-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
          <span class="text-xs uppercase tracking-[0.26em] text-sage-dark font-semibold block">
            Tecnología &amp; Sensibilidad Editorial
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl text-charcoal font-normal">
            Todo lo que tus invitados necesitan, en un solo enlace
          </h2>
          <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
            Sin descargar aplicaciones ni registros complicados. Tus invitados abren la invitación
            desde su celular o computadora con una fluidez extraordinaria.
          </p>
        </div>

        <FeaturesGrid client:visible />
      </div>
    </section>

    <!-- HOW IT WORKS / PROCESS SECTION -->
    <section id="proceso" class="py-20 sm:py-28">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
          <span class="text-xs uppercase tracking-[0.26em] text-gold-dark font-semibold block">
            Experiencia Sin Estrés
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl text-charcoal font-normal">
            Tu invitación lista en 4 pasos sencillos
          </h2>
          <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
            Nosotros nos encargamos de todo el diseño, configuración de mapas y pruebas técnicas
            para que vosotros solo disfrutéis de los preparativos.
          </p>
        </div>

        <ProcessSteps />
      </div>
    </section>

    <!-- FAQ ACCORDION SECTION -->
    <section id="preguntas" class="py-20 sm:py-28 border-t border-ivory-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <span class="text-xs uppercase tracking-[0.26em] text-gold-dark font-semibold block">
            Resolvemos tus Dudas
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl text-charcoal font-normal">
            Preguntas Frecuentes
          </h2>
          <p class="text-sm text-charcoal-muted">
            Todo lo que necesitas saber sobre tiempos de entrega, confirmaciones y personalización.
          </p>
        </div>

        <FaqAccordion client:visible />
      </div>
    </section>
  </main>

  <!-- Floating WhatsApp Concierge -->
  <FloatingWhatsApp />

  <!-- Footer -->
  <Footer />
</Layout>
